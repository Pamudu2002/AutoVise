# ── Database ───────────────────────────────────────────────────────────────
# Neon (pooled) or any Postgres 16 with the pgvector extension:
#   DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Zero-setup local database (embedded PGlite with pgvector, stored in .data/):
DATABASE_URL=pglite:./.data/pglite

# ── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Super-admin created by `npm run db:seed` (change the password after first sign-in)
SEED_ADMIN_EMAIL=admin@autovise.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# ── Gemini (optional locally: without it extraction is manual, pitches use the deterministic template and chat is offline)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_FLASH_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-3.1-pro-preview   # needs a paid plan; set to gemini-3.8-flash on the free tier
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Vercel Blob (optional locally: files are stored in .data/uploads) ─────
BLOB_READ_WRITE_TOKEN=

# ── Inngest (optional locally: jobs run in-process; set INNGEST_DEV=1 to use `npx inngest-cli dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1

# ── Upstash Redis (optional: without it the chat rate limit uses a database counter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL, used for OG images and the pitch PDF
NEXT_PUBLIC_SITE_URL=http://localhost:3000
